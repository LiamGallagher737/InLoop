{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v inloop >/dev/null 2>&1 && inloop session hook || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v inloop >/dev/null 2>&1 && inloop session hook || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v inloop >/dev/null 2>&1 && inloop session hook || true",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v inloop >/dev/null 2>&1 && inloop session hook || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
