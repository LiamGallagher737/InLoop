---
source: crates/mcp/tests/tools.rs
expression: tools
---
[
  {
    "name": "context",
    "description": "Where you are: the project, repo, worktree, branch, the main branch, and how far ahead of or behind main you are.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "decision_accept",
    "description": "Accept proposed decisions because a human said so. `basis` must quote the human's words; never accept a decision on your own judgement. When the human accepts several at once, pass all their IDs in one call: every ID is checked first, so a wrong one changes nothing; the result lists what was accepted and what failed.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "ids",
        "basis"
      ],
      "type": "object",
      "properties": {
        "ids": {
          "description": "The proposed decisions to accept, e.g. [\"D-7KQ2\", \"P5PT\"]. The prefix is optional.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "basis": {
          "description": "The human's words accepting them, quoted.",
          "type": "string"
        },
        "decided_by": {
          "description": "The human who accepted it.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  {
    "name": "decision_get",
    "description": "Get decisions in full by ID (old aliases such as D-264 also work), with their provenance. Pass several IDs to get them all in one call.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "ids"
      ],
      "type": "object",
      "properties": {
        "ids": {
          "description": "One or more decision IDs such as D-7KQ2 (or 7KQ2: the prefix is optional), or old aliases such as D-264.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "decision_list",
    "description": "List decisions, newest first, with optional filters. Includes decisions on other branches and worktrees, marked unmerged.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "status": {
          "description": "Only this status: proposed, accepted, rejected or superseded.",
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "description": "Only decisions with this tag.",
          "type": [
            "string",
            "null"
          ]
        },
        "unmerged_only": {
          "description": "Only decisions not merged into the main branch yet.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "since": {
          "description": "Only decisions dated on or after this day (YYYY-MM-DD).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  {
    "name": "decision_new",
    "description": "Record a decision as a new file in this worktree. The rule: a decision is something a human decided. Record it as `accepted` only when a human on the project made it, or it is unmistakably clear from what they said, and quote them in `basis`. A choice you made yourself, however sensible, is `proposed` (the default); say in your reply that it needs the human's call. Everything written is redacted first.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "title",
        "context",
        "decision",
        "consequences"
      ],
      "type": "object",
      "properties": {
        "title": {
          "description": "One line, stated as the decision itself, e.g. \"Snap writes go through one helper\".",
          "type": "string"
        },
        "context": {
          "description": "Why this came up.",
          "type": "string"
        },
        "decision": {
          "description": "What was decided, in a few sentences.",
          "type": "string"
        },
        "consequences": {
          "description": "What follows from it, including what it rules out.",
          "type": "string"
        },
        "status": {
          "description": "\"accepted\" only when a human made the decision and `basis` quotes them. Otherwise\nleave it out (or \"proposed\").",
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "description": "Required for accepted: the human's words, quoted, or a pointer to where they said it.",
          "type": [
            "string",
            "null"
          ]
        },
        "decided_by": {
          "description": "The human who made it, for accepted decisions.",
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "description": "Free-form tags for search.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "description": "IDs of decisions this one replaces. They must be in this worktree.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "decision_reject",
    "description": "Reject proposed decisions because a human said so. Pass several IDs to reject them in one call; the result lists what was rejected and what failed.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "ids"
      ],
      "type": "object",
      "properties": {
        "ids": {
          "description": "The proposed decisions to reject. The prefix is optional.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "description": "The human's reason, quoted, if they gave one.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  {
    "name": "decision_search",
    "description": "Search this project's decisions: on the main branch, in every worktree and on every unmerged branch. Use it before making a choice a past decision may cover. Results carry provenance: `unmerged` means work in progress elsewhere, not settled fact.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "query"
      ],
      "type": "object",
      "properties": {
        "query": {
          "description": "Words to search for. Every word must match, as a prefix; if nothing\nmatches, any word may.",
          "type": "string"
        },
        "limit": {
          "description": "Maximum results (default 10).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    }
  },
  {
    "name": "decision_supersede",
    "description": "Record that one decision replaces another. Both files must be in this worktree; both are updated together.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "old",
        "new"
      ],
      "type": "object",
      "properties": {
        "old": {
          "description": "The decision being replaced.",
          "type": "string"
        },
        "new": {
          "description": "The decision that replaces it.",
          "type": "string"
        }
      }
    }
  },
  {
    "name": "search",
    "description": "Search decisions and session summaries together. Results carry provenance: `unmerged` means work in progress elsewhere, not settled fact.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "query"
      ],
      "type": "object",
      "properties": {
        "query": {
          "description": "Words to search for. Every word must match, as a prefix; if nothing\nmatches, any word may.",
          "type": "string"
        },
        "limit": {
          "description": "Maximum results (default 10).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    }
  },
  {
    "name": "session_get",
    "description": "Get a captured session's summary, commits and decisions, with provenance. Set `transcript` for the full redacted transcript (paged with offset and max_chars) only when the summary isn't enough.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "id"
      ],
      "type": "object",
      "properties": {
        "id": {
          "description": "Session ID, or a unique prefix of it.",
          "type": "string"
        },
        "transcript": {
          "description": "Include the full redacted transcript. Large: ask only when the summary isn't enough.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "offset": {
          "description": "With `transcript`, skip this many characters of it (for paging).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "max_chars": {
          "description": "With `transcript`, return at most this many characters (default 40000).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        }
      }
    }
  },
  {
    "name": "session_search",
    "description": "Search summaries of past agent sessions in this project: what was asked, what was done, files touched, decisions made. Use it to find out why something was done.",
    "input_schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "required": [
        "query"
      ],
      "type": "object",
      "properties": {
        "query": {
          "description": "Words to search for. Every word must match, as a prefix; if nothing\nmatches, any word may.",
          "type": "string"
        },
        "limit": {
          "description": "Maximum results (default 10).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    }
  }
]
